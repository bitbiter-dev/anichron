{
  "stryker-config": {
    "solution": "Anichron.slnx",
    "test-runner": "mtp",
    "mutate": [
      "!**/Migrations/**",
      "!**/Anichron.API/Program.cs",
      "!**/Anichron.Worker/Program.cs",
      "!**/Anichron.Core/Data/AnichronDbContextFactory.cs",
      "!**/Anichron.Worker/Ingestion/Proxy/SystemProcessLauncher.cs",
      "!**/Anichron.API/Infrastructure/DatabaseStartupExtensions.cs",
      "!**/Anichron.API/Infrastructure/WebApplicationBuilderExtensions.cs",
      "!**/Anichron.Worker/Infrastructure/HostApplicationBuilderExtensions.cs",
      "!**/Anichron.Infrastructure/Data/DatabaseFacadeExtensions.cs"
    ],
    "ignore-methods": [
      "Log.*",
      "UnreachableException.ctor"
    ],
    "thresholds": {
      "high": 80,
      "low": 42,
      "break": 42
    },
    "reporters": [
      "progress",
      "html",
      "json",
      "markdown"
    ]
  }
}
