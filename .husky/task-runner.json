{
  "$schema": "https://alirezanet.github.io/Husky.Net/schema.json",
  "tasks": [
    {
      "name": "tool-versions",
      "group": "pre-commit",
      "command": "bash",
      "args": ["scripts/tool-versions.sh"]
    },
    {
      "name": "lfs-pointers",
      "group": "pre-commit",
      "command": "bash",
      "args": ["scripts/lfs-pointers.sh"]
    },
    {
      "name": "format-check",
      "group": "pre-commit",
      "command": "dotnet",
      "args": ["format", "whitespace", "src/", "--folder", "--verify-no-changes", "--include", "${staged}"],
      "filteringRule": "staged",
      "pathMode": "absolute",
      "include": ["src/**/*.cs"]
    },
    {
      "name": "ui-format",
      "group": "pre-commit",
      "command": "pnpm",
      "args": ["--dir", "src/Anichron.UI", "exec", "prettier", "--check", "--cache", "--ignore-unknown", "${staged}"],
      "filteringRule": "staged",
      "pathMode": "absolute",
      "include": ["src/Anichron.UI/**"]
    },
    {
      "name": "ui-lint",
      "group": "pre-commit",
      "command": "pnpm",
      "args": [
        "--dir",
        "src/Anichron.UI",
        "exec",
        "eslint",
        "--cache",
        "--cache-location",
        "node_modules/.cache/eslint/",
        "--no-warn-ignored",
        "${staged}"
      ],
      "filteringRule": "staged",
      "pathMode": "absolute",
      "include": ["src/Anichron.UI/**/*.ts", "src/Anichron.UI/**/*.tsx", "src/Anichron.UI/**/*.js", "src/Anichron.UI/**/*.cjs"]
    },
    {
      "name": "ui-typecheck",
      "group": "pre-commit",
      "command": "pnpm",
      "args": ["--dir", "src/Anichron.UI", "typecheck"],
      "filteringRule": "staged",
      "include": ["src/Anichron.UI/**"]
    },
    {
      "name": "ui-depcruise",
      "group": "pre-commit",
      "command": "pnpm",
      "args": ["--dir", "src/Anichron.UI", "depcruise"],
      "filteringRule": "staged",
      "include": ["src/Anichron.UI/**"]
    },
    {
      "name": "build",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["build", "src/", "-v", "q"]
    },
    {
      "name": "test",
      "group": "pre-push",
      "command": "dotnet",
      "args": ["test", "src/", "--no-build", "-v", "q"]
    },
    {
      "name": "ui-test",
      "group": "pre-push",
      "command": "bash",
      "args": ["scripts/ui-pre-push.sh"]
    }
  ]
}
