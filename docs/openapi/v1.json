        }
      }
    },
    "/api/v1/admin/work-items/{workItemId}/cancel": {
      "post": {
        "tags": [
          "Work items"
        ],
        "summary": "Cancels a queued item at once (200), or asks the running item's Worker to cancel it at its\nnext heartbeat (202). A finished item is a 409 showing the item as it is.",
        "parameters": [
          {
            "name": "workItemId",
            "in": "path",
            "description": "The item to cancel.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemDto"
                }
              }
            }
          },
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemDto"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkItemDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          }
        }
      }
    },
    "/api/v1/admin/proxy-sweeps": {
      "post": {
        "tags": [
          "Proxy sweeps"
        ],
        "summary": "Queues a sweep, or returns the one already queued.",
        "responses": {
          "202": {
            "description": "202 with the sweep's work item, whose status and progress the work-item endpoints show.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxySweepRequestedDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/admin/proxy-sweeps/{sweepId}/orphans": {
      "get": {
        "tags": [
          "Proxy sweeps"
        ],
        "parameters": [
          {
            "name": "sweepId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "outcome",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/ProxyDeletionOutcome"
            }
          },
          {
            "name": "pending",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "storageConfigId",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyOrphanPageDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    },
    "/api/v1/admin/proxy-sweeps/{sweepId}/deletions": {
      "post": {
        "tags": [
          "Proxy sweeps"
        ],
        "summary": "Queues one deletion per storage config the selected orphans name; orphans of configs that no\nlonger exist, or of none, share one unscoped deletion.",
        "parameters": [
          {
            "name": "sweepId",
            "in": "path",
            "description": "The sweep whose orphans to delete.",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "description": "Cancels the request.",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProxyDeletionRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProxyDeletionsRequestedDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found"
          },
          "409": {
            "description": "Conflict"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChangePasswordRequest": {
        "required": [
          "currentPassword",
          "newPassword"
        ],
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string"
          },
          "newPassword": {
            "type": "string"
          }
        }
      },
      "CreateAdminUserRequest": {
        "required": [
          "username",
          "email"
        ],
        "type": "object",
        "properties": {
          "username": {
            "type": "string"
          },
          "email": {
            "type": "string"
          }
        }
      },
      "CreateStorageConfigRequest": {
        "required": [
          "rootPath"
        ],
        "type": "object",
        "properties": {
          "rootPath": {
            "type": "string"
          }
        }
      },
      "HttpValidationProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          },
          "errors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "JsonElement": { },
      "LoginRequest": {
        "required": [
          "usernameOrEmail",
          "password"
        ],
        "type": "object",
        "properties": {
          "usernameOrEmail": {
            "type": "string"
          },
          "password": {
            "type": "string"
          }
        }
      },
      "PatchAdminUserRequest": {
        "required": [
          "isAdmin",
          "isDisabled"
        ],
        "type": "object",
        "properties": {
          "isAdmin": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "isDisabled": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "PatchInteractionRequest": {
        "required": [
          "starred",
          "liked",
          "hidden"
        ],
        "type": "object",
        "properties": {
          "starred": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "liked": {
            "type": [
              "null",
              "boolean"
            ]
          },
          "hidden": {
            "type": [
              "null",
              "boolean"
            ]
          }
        }
      },
      "ProxyDeletionOutcome": {
        "type": "integer"
      },
      "ProxyDeletionRequest": {
        "required": [
          "orphanIds",
          "all"
        ],
        "type": "object",
        "properties": {
          "orphanIds": {
            "type": [
              "null",
              "array"
            ],
            "items": {
              "type": "string",
              "format": "uuid"
            }
          },
          "all": {
            "type": "boolean"
          }
        }
      },
      "ProxyDeletionsRequestedDto": {
        "required": [
          "workItemIds"
        ],
        "type": "object",
        "properties": {
          "workItemIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            }
          }
        }
      },
      "ProxyOrphanDto": {
        "required": [
          "id",
          "proxyPath",
          "storageConfigId",
          "sizeBytes",
          "lastWriteTime",
          "outcome",
          "processedAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "proxyPath": {
            "type": "string"
          },
          "storageConfigId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "sizeBytes": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "lastWriteTime": {
            "type": "string"
          },
          "outcome": {
            "type": [
              "null",
              "string"
            ]
          },
          "processedAt": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProxyOrphanPageDto": {
        "required": [
          "items",
          "page",
          "pageSize",
          "total"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProxyOrphanDto"
            }
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
